      "wrongCommand": "git push sin remoto configurado",
      "whyWrong": "Git no sabe adónde subir.",
      "reportHint": "Luego revisar archivos en GitHub.",
      "steps": [
        {
          "id": "scenario-push-step-1",
          "command": "git status",
          "explanation": "Confirma estado limpio."
        },
        {
          "id": "scenario-push-step-2",
          "command": "git push -u origin main",
          "explanation": "Sube commits."
        },
        {
          "id": "scenario-push-step-3",
          "command": "abrir GitHub",
          "explanation": "Verifica archivos."
        }
      ]
    },
    {
      "id": "scenario-error",
      "title": "Detectar error común",
      "difficulty": "Media-alta",
