    },
    {
      "id": "scenario-log",
      "title": "Revisar historial",
      "difficulty": "Inicial",
      "context": "Querés ver versiones guardadas.",
      "objective": "Leer commits recientes.",
      "simulatedStatus": "a1b2c3d Mejorar botón\\nb2c3d4e Crear página inicial",
