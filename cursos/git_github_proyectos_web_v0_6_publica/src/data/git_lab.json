  "comparisons": [
    {
      "id": "compare-add-all",
      "title": "Agregar todo sin revisar",
      "wrong": "git add .",
      "right": "git status\\ngit add index.html styles.css",
      "explanation": "Primero se revisa el estado."
    },
    {
      "id": "compare-message",
      "title": "Mensaje genérico",
      "wrong": "git commit -m \"update\"",
      "right": "git commit -m \"Crear formulario de contacto\"",
      "explanation": "El mensaje debe explicar el cambio."
    },
    {
      "id": "compare-secret",
      "title": "Subir archivo sensible",
